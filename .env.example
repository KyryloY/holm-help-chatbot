# Copy to .env and fill in values.
# LangChain Google GenAI reads GOOGLE_API_KEY.
# If you only have GEMINI_API_KEY, the app copies it to GOOGLE_API_KEY at startup.

GOOGLE_API_KEY=your-google-ai-api-key

# Verified against LangChain docs (init_chat_model + google_genai) and Google Gemini model list:
# https://docs.langchain.com/oss/python/langchain/models
MODEL=google_genai:gemini-3.7-flash

# Fixed demo clock (ISO date). Override only for experiments.
DEMO_TODAY=2026-10-08

# orders | down — set to "down" to simulate order-service outage
ORDERS_MODE=orders

# SQLite paths (kept out of git)
CHECKPOINT_DB=./data/checkpoints.db
JOURNAL_DB=./data/returns_journal.db
TICKETS_DB=./data/tickets.db
CHAINLIT_DB=./data/chainlit.db

# Enable local Chainlit SQLite data layer for chat transcript persistence (1/0)
CHAINLIT_PERSIST_CHAT=1
